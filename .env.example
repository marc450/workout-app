# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key both work here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public URL of the deployed app (used for the magic-link redirect)
NEXT_PUBLIC_SITE_URL=https://<app>.up.railway.app

# The only email address allowed to sign in. Server-side only.
ALLOWED_EMAIL=you@example.com
